	partition Atendimentos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaDados, "\") & "\fato_atendimentos.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"atendimento_id", "codigo_worklab", "data", "paciente_pseudo", "ubs_id", "origem_ubs", "convenio", "tinha_agendamento", "qtd_exames", "valor_total"}, MissingField.UseNull),
				    Vazios = Table.TransformColumns(Colunas, {}, each if _ = "" then null else _),
				    SemUBS = Table.ReplaceValue(Vazios, null, 0, Replacer.ReplaceValue, {"ubs_id"}),
				    Nomes = Table.RenameColumns(SemUBS, {{"codigo_worklab", "Código Worklab"}, {"origem_ubs", "Origem da UBS"}, {"convenio", "Convênio"}, {"tinha_agendamento", "Tinha Agendamento"}}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Nomes,{{"data", type date}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

