	partition 'Não Conformidades' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaDados, "\") & "\fato_nao_conformidades.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"nc_id", "data", "etapa", "categoria", "prioridade", "status", "setor", "ubs_id", "prazo", "concluida_em", "dias_resolucao", "vencida", "qtd_acoes", "acoes_concluidas"}, MissingField.UseNull),
				    Vazios = Table.TransformColumns(Colunas, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vazios, {{"nc_id", Int64.Type}, {"data", type date}, {"etapa", type text}, {"categoria", type text}, {"prioridade", type text}, {"status", type text}, {"setor", type text}, {"ubs_id", Int64.Type}, {"prazo", type date}, {"concluida_em", type date}, {"dias_resolucao", Int64.Type}, {"vencida", type logical}, {"qtd_acoes", Int64.Type}, {"acoes_concluidas", Int64.Type}}, "en-US"),
				    SemUBS = Table.ReplaceValue(Tipos, null, 0, Replacer.ReplaceValue, {"ubs_id"}),
				    Nomes = Table.RenameColumns(SemUBS, {{"etapa", "Etapa"}, {"categoria", "Categoria"}, {"prioridade", "Prioridade"}, {"status", "Status"}, {"setor", "Setor"}, {"prazo", "Prazo"}, {"concluida_em", "Concluída em"}, {"vencida", "Vencida"}})
				in
				    Nomes

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

