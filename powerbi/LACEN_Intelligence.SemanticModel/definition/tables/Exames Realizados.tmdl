	partition 'Exames Realizados' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaDados, "\") & "\fato_exames.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"atendimento_exame_id", "atendimento_id", "data", "ubs_id", "exame_id", "quantidade", "valor", "situacao", "liberado_em", "tat_horas", "dentro_prazo"}, MissingField.UseNull),
				    Vazios = Table.TransformColumns(Colunas, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vazios, {{"atendimento_exame_id", Int64.Type}, {"atendimento_id", Int64.Type}, {"data", type date}, {"ubs_id", Int64.Type}, {"exame_id", Int64.Type}, {"quantidade", Int64.Type}, {"valor", Currency.Type}, {"situacao", type text}, {"liberado_em", type datetime}, {"tat_horas", type number}, {"dentro_prazo", type logical}}, "en-US"),
				    SemUBS = Table.ReplaceValue(Tipos, null, 0, Replacer.ReplaceValue, {"ubs_id"}),
				    Nomes = Table.RenameColumns(SemUBS, {{"situacao", "Situação"}, {"liberado_em", "Liberado em"}, {"dentro_prazo", "Dentro do Prazo"}})
				in
				    Nomes

