		sourceColumn: Atendido no Lab

		annotation SummarizationSetBy = Automatic

	partition Agendamentos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaDados, "\") & "\fato_agendamentos.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"agendamento_id", "data", "horario", "ubs_id", "paciente_pseudo", "tipo", "status", "compareceu", "faltou", "realizado", "atendido_no_lab"}, MissingField.UseNull),
				    Vazios = Table.TransformColumns(Colunas, {}, each if _ = "" then null else _),
				    SemUBS = Table.ReplaceValue(Vazios, null, 0, Replacer.ReplaceValue, {"ubs_id"}),
				    Nomes = Table.RenameColumns(SemUBS, {{"horario", "Horário"}, {"tipo", "Tipo"}, {"status", "Status"}, {"atendido_no_lab", "Atendido no Lab"}}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Nomes,{{"data", type date}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

