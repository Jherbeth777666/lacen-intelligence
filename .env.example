# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.

# Postgres local (docker compose) ou Supabase:
# Supabase → Project Settings → Database → Connection string (URI), troque postgresql:// por postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lacen

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Segredo da pseudonimização dos pacientes (HMAC). Guarde em cofre; se mudar, todos os PAC_ mudam.
PSEUDO_SECRET=

# Analista IA (opcional — sem chave o sistema usa o modo analítico offline)
# IA do Analista (opcional). Gemini tem prioridade; sem chave = modo offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# 1 = mostra a faixa "Base de demonstração (dados fictícios)" na interface
BASE_DEMO=1
SESSION_COOKIE_SECURE=0
