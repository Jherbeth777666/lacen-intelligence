<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_asis" targetNamespace="http://lacen.intelligence/bpmn">
  <bpmn:collaboration id="Colab_asis">
    <bpmn:participant id="Pool_asis" name="LACEN — processo atual (AS-IS)" processRef="Proc_asis"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_asis" isExecutable="false"><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_0" name="UBS"><bpmn:flowNodeRef>ini</bpmn:flowNodeRef><bpmn:flowNodeRef>agendar</bpmn:flowNodeRef><bpmn:flowNodeRef>falta</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="LACEN · Recepção e triagem"><bpmn:flowNodeRef>comp</bpmn:flowNodeRef><bpmn:flowNodeRef>cadastro</bpmn:flowNodeRef><bpmn:flowNodeRef>triagem</bpmn:flowNodeRef><bpmn:flowNodeRef>coleta</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="LACEN · Laboratório"><bpmn:flowNodeRef>adequada</bpmn:flowNodeRef><bpmn:flowNodeRef>analise</bpmn:flowNodeRef><bpmn:flowNodeRef>liberar</bpmn:flowNodeRef><bpmn:flowNodeRef>fim</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_3" name="Gestão"><bpmn:flowNodeRef>exportar</bpmn:flowNodeRef><bpmn:flowNodeRef>relatorio</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="ini" name="Solicitação médica"><bpmn:outgoing>F0</bpmn:outgoing></bpmn:startEvent><bpmn:manualTask id="agendar" name="Agendar em planilha (todos às 07:00)"><bpmn:incoming>F0</bpmn:incoming><bpmn:outgoing>F1</bpmn:outgoing></bpmn:manualTask><bpmn:exclusiveGateway id="comp" name="Paciente compareceu?"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing><bpmn:outgoing>F3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="falta" name="Vaga perdida"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent><bpmn:manualTask id="cadastro" name="Conferir e redigitar cadastro"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:manualTask><bpmn:manualTask id="triagem" name="Triagem manual dos exames"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:manualTask><bpmn:manualTask id="coleta" name="Coleta"><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:manualTask><bpmn:exclusiveGateway id="adequada" name="Amostra adequada?"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing><bpmn:outgoing>F8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="analise" name="Processar e analisar"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task><bpmn:manualTask id="liberar" name="Liberar laudo"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F11</bpmn:outgoing></bpmn:manualTask><bpmn:endEvent id="fim" name="Resultado liberado"><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent><bpmn:manualTask id="exportar" name="Exportar Worklab e montar planilhas (mensal)"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:manualTask><bpmn:endEvent id="relatorio" name="Relatório tardio, sem cruzamento"><bpmn:incoming>F12</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F0" sourceRef="ini" targetRef="agendar"/><bpmn:sequenceFlow id="F1" sourceRef="agendar" targetRef="comp"/><bpmn:sequenceFlow id="F2" sourceRef="comp" targetRef="falta" name="Não"/><bpmn:sequenceFlow id="F3" sourceRef="comp" targetRef="cadastro" name="Sim"/><bpmn:sequenceFlow id="F4" sourceRef="cadastro" targetRef="triagem"/><bpmn:sequenceFlow id="F5" sourceRef="triagem" targetRef="coleta"/><bpmn:sequenceFlow id="F6" sourceRef="coleta" targetRef="adequada"/><bpmn:sequenceFlow id="F7" sourceRef="adequada" targetRef="coleta" name="Não (recoleta)"/><bpmn:sequenceFlow id="F8" sourceRef="adequada" targetRef="analise" name="Sim"/><bpmn:sequenceFlow id="F9" sourceRef="analise" targetRef="liberar"/><bpmn:sequenceFlow id="F10" sourceRef="liberar" targetRef="fim"/><bpmn:sequenceFlow id="F11" sourceRef="liberar" targetRef="exportar"/><bpmn:sequenceFlow id="F12" sourceRef="exportar" targetRef="relatorio"/></bpmn:process>
