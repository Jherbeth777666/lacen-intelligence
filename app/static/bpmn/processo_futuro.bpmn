  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_tobe" targetNamespace="http://lacen.intelligence/bpmn">
  <bpmn:collaboration id="Colab_tobe">
    <bpmn:participant id="Pool_tobe" name="LACEN — processo futuro (TO-BE)" processRef="Proc_tobe"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_tobe" isExecutable="false"><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_0" name="UBS"><bpmn:flowNodeRef>ini</bpmn:flowNodeRef><bpmn:flowNodeRef>agendar</bpmn:flowNodeRef><bpmn:flowNodeRef>lembrete</bpmn:flowNodeRef><bpmn:flowNodeRef>motivo</bpmn:flowNodeRef><bpmn:flowNodeRef>falta</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="LACEN · Recepção e triagem"><bpmn:flowNodeRef>comp</bpmn:flowNodeRef><bpmn:flowNodeRef>triagem</bpmn:flowNodeRef><bpmn:flowNodeRef>coleta</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="LACEN · Laboratório"><bpmn:flowNodeRef>adequada</bpmn:flowNodeRef><bpmn:flowNodeRef>nc</bpmn:flowNodeRef><bpmn:flowNodeRef>analise</bpmn:flowNodeRef><bpmn:flowNodeRef>liberar</bpmn:flowNodeRef><bpmn:flowNodeRef>fim</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_3" name="Gestão"><bpmn:flowNodeRef>etl</bpmn:flowNodeRef><bpmn:flowNodeRef>alertas</bpmn:flowNodeRef><bpmn:flowNodeRef>plano</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="ini" name="Solicitação médica"><bpmn:outgoing>F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="agendar" name="Agendar em blocos de 30 min"><bpmn:incoming>F0</bpmn:incoming><bpmn:outgoing>F1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="lembrete" name="Lembrete automático 48 h antes"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="comp" name="Paciente compareceu?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="motivo" name="Registrar motivo da falta"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="falta" name="Vaga liberada / reagendada"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="triagem" name="Triagem no sistema (pré-cadastro vindo da agenda)"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="coleta" name="Coleta com checklist pré-analítico"><bpmn:incoming>F6</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="adequada" name="Amostra adequada?"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="nc" name="Registrar NC e recoletar"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:userTask><bpmn:task id="analise" name="Processar com alerta de TAT"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task><bpmn:task id="liberar" name="Liberar laudo"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task><bpmn:endEvent id="fim" name="Resultado liberado no prazo"><bpmn:incoming>F12</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="etl" name="ETL diário: validar, anonimizar, carregar"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="alertas" name="Indicadores + alertas + Analista IA"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="plano" name="Decisão e plano 5W2H"><bpmn:incoming>F15</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F0" sourceRef="ini" targetRef="agendar"/><bpmn:sequenceFlow id="F1" sourceRef="agendar" targetRef="lembrete"/><bpmn:sequenceFlow id="F2" sourceRef="lembrete" targetRef="comp"/><bpmn:sequenceFlow id="F3" sourceRef="comp" targetRef="motivo" name="Não"/><bpmn:sequenceFlow id="F4" sourceRef="motivo" targetRef="falta"/><bpmn:sequenceFlow id="F5" sourceRef="comp" targetRef="triagem" name="Sim"/><bpmn:sequenceFlow id="F6" sourceRef="triagem" targetRef="coleta"/><bpmn:sequenceFlow id="F7" sourceRef="coleta" targetRef="adequada"/><bpmn:sequenceFlow id="F8" sourceRef="adequada" targetRef="nc" name="Não"/><bpmn:sequenceFlow id="F9" sourceRef="nc" targetRef="coleta"/><bpmn:sequenceFlow id="F10" sourceRef="adequada" targetRef="analise" name="Sim"/><bpmn:sequenceFlow id="F11" sourceRef="analise" targetRef="liberar"/><bpmn:sequenceFlow id="F12" sourceRef="liberar" targetRef="fim"/><bpmn:sequenceFlow id="F13" sourceRef="liberar" targetRef="etl"/><bpmn:sequenceFlow id="F14" sourceRef="etl" targetRef="alertas"/><bpmn:sequenceFlow id="F15" sourceRef="alertas" targetRef="plano"/></bpmn:process>
